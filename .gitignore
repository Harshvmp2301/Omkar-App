# Dependencies
node_modules/
.pnpm-store/
yarn-error.log
yarn.lock
pnpm-lock.yaml
# package-lock.json IS committed — CI runs `npm ci` for reproducible installs.

# Build outputs
dist/
build/
.vite/
.cache/

# Vercel CLI (contains project/org ids — never commit)
.vercel/

# Environment variables
.env
.env.local
.env.production

# Credentials live in config/.env.local and are never committed.
# The blank template (config/.env.example) IS committed on purpose.
config/.env
config/.env.local
config/.env.*.local

# IDE folders
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# System files
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Testing
coverage/

# Temporary files
tmp/
temp/
# History backup — survives workspace re-provisions (inside repo = preserved)
.backup/

# Visible staging folder for manual file transfer (Method B)
transfer/
