+# â”€â”€ Optional integrations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+# Copy to `.env.local` (git-ignored) or paste values into
+# Vercel â†’ Project â†’ Settings â†’ Environment Variables.
+# NEVER commit real keys. In the Next.js migration these become
+# NEXT_PUBLIC_YOUTUBE_API_KEY / NEXT_PUBLIC_YOUTUBE_CHANNEL_ID /
+# NEXT_PUBLIC_FORM_ENDPOINT (same values, new names).
+
+# YouTube Data API v3 â€” enables the live uploads feed on the Content Hub.
+# Leave empty â†’ curated video list (default, zero-config).
+VITE_YOUTUBE_API_KEY=
+# Channel id starting with UCâ€¦ (uploads playlist derived UCxxxx â†’ UUxxxx).
+VITE_YOUTUBE_CHANNEL_ID=
+
+# Form submission endpoint â€” any CORS-enabled JSON webhook
+# (Formspree, Google Apps Script, SheetDB, your own API).
+# Leave empty â†’ forms keep their mailto flow (default, zero-config).
+VITE_FORM_ENDPOINT=
