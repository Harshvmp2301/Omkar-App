+  console.log("  then re-run with --force to convert.");
+}
+
+await mkdir(OUT_DIR, { recursive: true });
+const tmp = await mkdtemp(join(tmpdir(), "omkar-gallery-"));
+const usedNames = new Set(tasks.map(nameFor));
+const results = [];
+let failures = 0;
