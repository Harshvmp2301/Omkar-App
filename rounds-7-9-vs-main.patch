+  process.exit(0);
+}
+
+const converter = detectConverter();
+if (converter) {
+  console.log(`Converter: ${converter.bin} (${converter.kind}) â†’ WebP q${QUALITY}, max ${MAX_W}px`);
+} else {
+  console.log("âš  No WebP converter found (ImageMagick magick/convert or cwebp).");
+  console.log("  Photos will be saved as .jpg so hotlinks are removed anyway.");
+  console.log("  For WebP install one of:");
